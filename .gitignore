node_modules/
screenshots/
scripts/current.pine
temp_*
*.log
discovery-log.json

# Trade-execution webhook URL + shared secret. Never commit these: rules.json is tracked,
# so credentials live here (or in TRADE_WEBHOOK_URL / TRADE_WEBHOOK_SECRET) instead.
webhook.local.json

# Claude Code's own local session state (permission allow-lists, scheduler lock file) — machine-
# local, not project source.
.claude/

# One-off manual safety copies made before risky operations; git history is the real backup.
*.backup-*
trade-log/*.pre-*

# Stray stderr redirect artifacts from launching the dashboard server by hand.
*.err

# Manual ledger SQLite file (data/manual-ledger.db) — local runtime state in a binary format, not
# diff-friendly, unlike the tracked status/*.json and trade-log/*.csv. accounts.json (the picklist
# config half of that feature) IS tracked, same as rules.json.
data/
